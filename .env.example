# --- Environment ---
EXPO_PUBLIC_ENV=development

# --- Clerk ---
# Clerk Dashboard > API Keys > Publishable key (frontend-safe)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# --- Backend API ---
# For iOS simulator: http://localhost:4000
# For Android emulator: http://10.0.2.2:4000
# For physical device: http://<your-lan-ip>:4000
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Sentry (leave blank in local dev to disable) ---
EXPO_PUBLIC_SENTRY_DSN=
